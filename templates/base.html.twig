<!DOCTYPE html>
<html lang="fr">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title>{% block title %}WorkTogether{% endblock %}</title>
        {% block stylesheets %}
        {% endblock %}

        {% block javascripts %}
            {% block importmap %}{{ importmap('app') }}{% endblock %}
        {% endblock %}
    </head>
    <body>
        <header>
            <a href="{{ path('app_home') }}"><strong>WorkTogether</strong></a>
            <nav>
                {% if is_granted('ROLE_CLIENT') %}
                    <a href="{{ path('app_client_unite_index') }}">Mes unités</a>
                    <a href="{{ path('app_client_baie_index') }}">Mes baies</a>
                {% endif %}
                {% if app.user %}
                    <span>{{ app.user }}</span>
                    <a href="{{ path('app_logout') }}">Déconnexion</a>
                {% else %}
                    <a href="{{ path('app_login') }}">Connexion</a>
                    <a href="{{ path('app_register') }}">Créer un compte</a>
                {% endif %}
            </nav>
        </header>

        <main>
            {% for message in app.flashes('success') %}
                <div class="alert alert-success">{{ message }}</div>
            {% endfor %}

            {% block body %}{% endblock %}
        </main>
    </body>
</html>
