{% extends 'base.html.twig' %}

{% block title %}Baie {{ baie.numero }}{% endblock %}

{% block body %}
    <h1>Baie {{ baie.numero }}</h1>

    <p>Vos unités sont en gras. L'unité U01 est en bas de la baie.</p>

    <div class="baie">
        <ol>
            {% for unite in baie.unites %}
                {% if mesUnites[unite.id] is defined %}
                    <li class="a-moi">
                        <a href="{{ path('app_client_unite_show', {'id': unite.id}) }}">U{{ '%02d'|format(unite.numero) }}</a>
                        {% if unite.typeUnite %}<span class="couleur" style="background: {{ unite.typeUnite.couleur }}"></span>{% endif %}
                        {{ unite.nom }} ({{ unite.etat }})
                    </li>
                {% else %}
                    <li>U{{ '%02d'|format(unite.numero) }}</li>
                {% endif %}
            {% endfor %}
        </ol>
    </div>

    <p><a href="{{ path('app_client_baie_index') }}">retour à la liste</a></p>
{% endblock %}
