{% extends 'base.html.twig' %}

{% block title %}Mes baies{% endblock %}

{% block body %}
    <h1>Mes baies</h1>

    <table class="table">
        <thead>
            <tr>
                <th>Baie</th>
                <th>Mes unités dans cette baie</th>
                <th>actions</th>
            </tr>
        </thead>
        <tbody>
        {% for ligne in baies %}
            <tr>
                <td>{{ ligne.baie.numero }}</td>
                <td>{{ ligne.nbUnites }} / {{ ligne.baie.nbUnites }}</td>
                <td>
                    <a href="{{ path('app_client_baie_show', {'id': ligne.baie.id}) }}">voir</a>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="3">Vous n'avez d'unité dans aucune baie.</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>
{% endblock %}
