{% extends 'base.html.twig' %}

{% block title %}Mes unités{% endblock %}

{% block body %}
    <h1>Mes unités</h1>

    <table class="table">
        <thead>
            <tr>
                <th>Emplacement</th>
                <th>Nom</th>
                <th>Type</th>
                <th>État</th>
                <th>actions</th>
            </tr>
        </thead>
        <tbody>
        {% for unite in unites %}
            <tr>
                <td>{{ unite.emplacement }}</td>
                <td>{{ unite.nom }}</td>
                <td>
                    {% if unite.typeUnite %}
                        <span class="couleur" style="background: {{ unite.typeUnite.couleur }}"></span>
                        {{ unite.typeUnite.libelle }}
                    {% endif %}
                </td>
                <td>{{ unite.etat }}</td>
                <td>
                    <a href="{{ path('app_client_unite_show', {'id': unite.id}) }}">voir</a>
                    <a href="{{ path('app_client_unite_edit', {'id': unite.id}) }}">modifier</a>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="5">Vous ne louez aucune unité.</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>
{% endblock %}
