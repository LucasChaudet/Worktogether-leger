{% extends 'base.html.twig' %}

{% block title %}Mes commandes{% endblock %}

{% block body %}
    <h1>Mes commandes</h1>

    <table class="table">
        <thead>
        <tr>
            <th>Date</th>
            <th>Offre</th>
            <th>Période</th>
            <th>Paiement</th>
            <th>Prix</th>
            <th>actions</th>
        </tr>
        </thead>
        <tbody>
        {% for commande in commandes %}
            <tr>
                <td>{{ commande.dateCommande|date('d/m/Y') }}</td>
                <td>{{ commande.offre.libelle }}</td>
                <td>du {{ commande.dateDebut|date('d/m/Y') }} au {{ commande.dateFin|date('d/m/Y') }}</td>
                <td>{{ commande.annuel ? 'Annuel' : 'Mensuel' }}</td>
                <td>{{ commande.prix }} €</td>
                <td>
                    <a href="{{ path('app_client_commande_show', {'id': commande.id}) }}">voir</a>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="6">Vous n'avez passé aucune commande.</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

    <a href="{{ path('app_client_commande_new') }}">Passer une commande</a>
{% endblock %}
